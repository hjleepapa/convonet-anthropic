# Example environment variables for Convonet (copy to `.env` and fill in).
# See README.md, MIGRATION-PLAN.md, and convonet/CONVONET_DEPLOYMENT_CONFIG.md.

# ----- Telnyx (voice / TeXML migration; use alongside Twilio until cutover) -----
# API key v2: https://portal.telnyx.com/#/app/api-keys
TELNYX_API_KEY=
# Ed25519 public key for webhook signature verification
# https://portal.telnyx.com/#/app/account/public-key
TELNYX_PUBLIC_KEY=
# E.164 number on Telnyx (caller ID for outbound / bridge calls; parallels TWILIO_PHONE_NUMBER / TWILIO_TRANSFER_CALLER_ID)
TELNYX_PHONE_NUMBER=
# TeXML Application ID from Mission Control → Voice → TeXML Applications
TELNYX_TEXML_APP_ID=
# Optional: TeXML Accounts API path segment; defaults to TELNYX_TEXML_APP_ID if unset
# TELNYX_TEXML_ACCOUNT_SID=
# Set to true to force Twilio for WebRTC→PBX transfer even when TELNYX_* is set
# USE_TWILIO_VOICE_TRANSFER=false
# Optional: migration skill uses this name for voice “connection”; for TeXML-first, may match the same app or another portal ID — see Telnyx docs
# TELNYX_CONNECTION_ID=
# Optional: E.164 test handset for Telnyx migration scripts (preflight / smoke tests)
# TELNYX_TO_NUMBER=

# ----- Twilio (remove in Phase 6 after cutover) -----
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
# TWILIO_TRANSFER_CALLER_ID=
